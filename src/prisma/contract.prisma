// use prisma-8

// -=-=- MODELS -=-=-

model User {
  id          String  @id @onCreate(cuid(2))
  discordId   String  @unique
  username    String
  displayName String?
  avatarUrl   String?

  steamId         String?   @unique
  steamName       String?
  steamAvatarUrl  String?
  steamProfileUrl String?
  rankTier        Int?
  rankCheckedAt   DateTime?

  staff          StaffMember?
  memberships    TeamMember[]
  invitesCreated Invite[]     @relation("InviteCreatedBy")
  invitesUsed    Invite[]     @relation("InviteUsedBy")

  createdAt DateTime @onCreate(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  @@map("users")
}

model StaffMember {
  userId String    @id
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   StaffRole

  createdAt DateTime @onCreate(now())

  @@map("staff_members")
}

model Tournament {
  id             String           @id @onCreate(cuid(2))
  slug           String           @unique
  name           String
  status         TournamentStatus @default(DRAFT)
  rosterDeadline DateTime?
  rankLimit      Int?

  teams   Team[]
  invites Invite[]
  matches Match[]

  createdAt DateTime @onCreate(now())

  @@map("tournaments")
}

model Community {
  id        String  @id @onCreate(cuid(2))
  guildId   String  @unique
  name      String
  iconUrl   String?
  inviteUrl String?

  teams Team[]

  createdAt DateTime @onCreate(now())

  @@map("communities")
}

model Team {
  id   String @id @onCreate(cuid(2))
  name String
  slug String
  tag  String
  seed Int?

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  communityId  String
  community    Community  @relation(fields: [communityId], references: [id], onDelete: Restrict)

  members TeamMember[]
  invites Invite[]

  createdAt DateTime @onCreate(now())

  @@unique([id, tournamentId])
  @@unique([tournamentId, communityId])
  @@unique([tournamentId, slug])
  @@unique([tournamentId, seed])
  @@index([communityId])
  @@map("teams")
}

model TeamMember {
  id           String @id @onCreate(cuid(2))
  teamId       String
  tournamentId String
  team         Team   @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lineup    Lineup       @default(NONE)
  position  Int?
  isCaptain Boolean      @default(false)
  isManager Boolean      @default(false)
  status    MemberStatus @default(PENDING)

  createdAt DateTime @onCreate(now())

  @@index([teamId, position], unique: true, where: sql`"status" = 'ACTIVE' AND "lineup" = 'PLAYER'`, name: "team_members_slot")
  @@index([teamId], unique: true, where: sql`"isCaptain"`, name: "team_members_captain")
  @@check(expression: sql`("lineup" = 'PLAYER') = ("position" IS NOT NULL) AND ("position" IS NULL OR "position" BETWEEN 1 AND 5)`, name: "team_members_position")
  @@check(expression: sql`NOT "isCaptain" OR "lineup" = 'PLAYER'`, name: "team_members_captain_player")

  @@unique([tournamentId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Invite {
  id           String      @id @onCreate(cuid(2))
  kind         InviteKind
  tokenHash    String      @unique
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffRole    StaffRole?
  guildId      String?

  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?

  expiresAt DateTime
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?

  createdAt DateTime @onCreate(now())

  @@index([tournamentId])
  @@index([teamId])
  @@map("invites")
}

model Match {
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  key          String
  scoreA       Int?
  scoreB       Int?
  status       MatchStatus @default(UPCOMING)
  startsAt     DateTime?

  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  @@id([tournamentId, key])
  @@map("matches")
}

// -=-=- ENUMS -=-=-

enum StaffRole {
  OWNER
  ORGANIZER
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  LOCKED
  LIVE
  FINISHED
}

enum Lineup {
  PLAYER
  COACH
  NONE
}

enum MemberStatus {
  PENDING
  ACTIVE
}

enum InviteKind {
  STAFF
  COMMUNITY
  TEAM
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
}
